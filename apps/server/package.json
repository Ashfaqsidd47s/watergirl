{
  "name": "@watergirl/server",
  "version": "0.1.0",
  "private": true,
  "description": "Water Girl brain + worker: stores projects/tasks and runs coding agents in git worktrees.",
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
