    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@watergirl/shared": "*",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
